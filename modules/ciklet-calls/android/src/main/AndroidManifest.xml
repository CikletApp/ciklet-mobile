<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Kilit ekranında tam ekran gelen arama (Android 14+'ta kullanıcı onayı da gerekebilir). -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Süren görüşme: arka planda mikrofon/kamera kesilmesin (OngoingCallService). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
  <!-- Yakınlık sensörüyle ekran karartma (setProximityScreenOff). -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <application>
    <!-- "Reddet" eylemi: uygulama kapalıyken bile bildirimi düşürür ve sunucuya bildirir. -->
    <receiver
      android:name="expo.modules.cikletcalls.CallActionReceiver"
      android:exported="false" />
    <service
      android:name="expo.modules.cikletcalls.OngoingCallService"
      android:exported="false"
      android:foregroundServiceType="microphone|camera" />
  </application>
</manifest>
