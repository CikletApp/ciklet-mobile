# Yerel geliştirme: telefonun eriştiği API adresi (localhost DEĞİL —
# bilgisayarının LAN IP'si). Üretim değerleri .env.production ve
# eas.json profillerinde.
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000

# LiveKit sinyal adresi — SONUNA `/rtc` YAZILMAZ.
# livekit-client bu yolu kendisi ekler; buraya da yazılırsa istek
# `<adres>/rtc/rtc`'ye gider ve bağlantı hiç kurulmaz.
# Yerel LiveKit (ciklet-infra dev compose) doğrudan porttan dinler:
EXPO_PUBLIC_LIVEKIT_URL=ws://192.168.1.20:7880

# Gerçek zamanlı ağ geçidi (Rust, ADR-0012). Yerel yığında nginx olmadığı
# için doğrudan porta ve `/ws` yoluna gidilir (üretimde nginx
# `/gateway/ws`'i buraya çeviriyor). Boş bırakılırsa API adresinden türetilir
# (`wss://<api>/gateway/ws`), üretimde doğru olan budur.
EXPO_PUBLIC_GATEWAY_URL=ws://192.168.1.20:4000/ws
