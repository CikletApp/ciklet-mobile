{
  "expo": {
    "name": "Ciklet",
    "slug": "ciklet",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ciklet",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111214",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.ciklet.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Sesli kanallarda konuşabilmek için mikrofon erişimi gerekir.",
        "NSCameraUsageDescription": "Görüntülü görüşmelerde kamera erişimi gerekir.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ciklet.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#111214",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111214",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "d7880e52-def6-478d-a5b1-34b734fd578d"
      }
    }
  }
}
