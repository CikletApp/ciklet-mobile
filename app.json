{
  "expo": {
    "name": "Ciklet",
    "slug": "ciklet",
    "version": "0.2.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ciklet",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#120d1d",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.ciklet.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Sesli kanallarda konuşabilmek için mikrofon erişimi gerekir.",
        "NSCameraUsageDescription": "Görüntülü görüşmelerde ve masaüstü giriş kodunu okurken kamera erişimi gerekir.",
        "UIBackgroundModes": [
          "audio",
          "voip"
        ],
        "NSUserActivityTypes": [
          "INStartCallIntent",
          "INStartAudioCallIntent",
          "INStartVideoCallIntent"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ciklet.mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#6D28D9",
        "foregroundImage": "./assets/images/android-icon-symbol.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 4
    },
    "plugins": [
      "expo-router",
      "./plugins/with-splash-branding",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash/icon-light.png",
          "imageWidth": 88,
          "dark": {
            "backgroundColor": "#120d1d",
            "image": "./assets/images/splash/icon-dark.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#98cb00",
          "defaultChannel": "ciklet-messages",
          "sounds": [
            "./assets/sounds/ringtone.wav",
            "./assets/sounds/message.wav"
          ]
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication",
            "enableScreenShareService": true
          }
        }
      ],
      "./plugins/with-screen-share",
      "expo-image",
      "expo-web-browser",
      "expo-video",
      "@react-native-firebase/app",
      "@react-native-firebase/analytics",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fotoğraf göndermek ve sohbet arka planı seçmek için galeri erişimi gerekir.",
          "cameraPermission": "Fotoğraf çekip göndermek için kamera erişimi gerekir."
        }
      ],
      "expo-audio",
      "expo-iap",
      [
        "expo-camera",
        {
          "cameraPermission": "Görüntülü görüşmelerde ve masaüstü giriş kodunu okurken kamera erişimi gerekir.",
          "barcodeScannerEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "d7880e52-def6-478d-a5b1-34b734fd578d"
      }
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-3940256099942544~3347511713",
    "ios_app_id": "ca-app-pub-3940256099942544~1458002511",
    "delay_app_measurement_init": true
  }
}
