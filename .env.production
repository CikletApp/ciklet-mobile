# Üretim yapılandırması — release build'lerde .env'in yerine geçer.
#
# Buradaki değerler EXPO_PUBLIC_* olduğu için derleme anında paketin İÇİNE
# gömülür; yani SIR TAŞIYAMAZLAR ve depoda durmaları güvenlidir. Gerçek
# sırlar (API anahtarı, imzalama parolası) asla bu dosyaya girmez.
#
# Yerel release APK: `cd android && ./gradlew assembleRelease`
# EAS: aynı değerler eas.json'daki profil `env` bloğunda da tanımlı.

EXPO_PUBLIC_API_URL=https://ciklet.xyz

# LiveKit sinyal adresi. Boş bırakılırsa lib/config.ts bunu API kökünden
# türetir (https://ciklet.xyz → wss://ciklet.xyz/rtc); nginx /rtc yolunu
# SFU'ya proxy'liyor. Açıkça yazmak build'i okunur kılıyor.
EXPO_PUBLIC_LIVEKIT_URL=wss://ciklet.xyz/rtc
